# Public Mapbox token — basemap tiles rendered through MapLibre GL JS.
# Without it the atlas falls back to the CARTO dark basemap.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional: any Mapbox style id, e.g. mapbox/navigation-night-v1
NEXT_PUBLIC_MAPBOX_STYLE=mapbox/dark-v11

# Server-only. Without it the investigation runs in labelled "recorded" mode.
ANTHROPIC_API_KEY=
# claude-sonnet-4-5 today; switch to claude-fable-5-1 when you want Fable.
ANTHROPIC_MODEL_ID=claude-sonnet-4-5
